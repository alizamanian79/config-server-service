FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

ARG SPRING_CLOUD_CONFIG_SERVER_GIT_URI
ARG SPRING_CLOUD_CONFIG_SERVER_GIT_USERNAME
ARG SPRING_CLOUD_CONFIG_SERVER_GIT_PASSWORD

ENV SPRING_CLOUD_CONFIG_SERVER_GIT_URI=${SPRING_CLOUD_CONFIG_SERVER_GIT_URI} \
    SPRING_CLOUD_CONFIG_SERVER_GIT_USERNAME=${SPRING_CLOUD_CONFIG_SERVER_GIT_USERNAME} \
    SPRING_CLOUD_CONFIG_SERVER_GIT_PASSWORD=${SPRING_CLOUD_CONFIG_SERVER_GIT_PASSWORD}

RUN addgroup -S spring && adduser -S spring -G spring \
    && apk add --no-cache curl

COPY --from=build /app/target/config-server-0.0.1-SNAPSHOT.jar app.jar

USER spring:spring

EXPOSE 8888

ENTRYPOINT ["java", "-jar", "app.jar"]